name = "dmarc-dashboard-kit"
main = "src/index.ts"
compatibility_date = "2024-12-30"

[assets]
directory = "dashboard/dist"

[[d1_databases]]
binding = "DB"
database_name = "dmarc-reports"
database_id = ""  # auto-filled by deploy.sh

# Persisted, queryable logs in the Cloudflare dashboard (3-day retention).
# Free-tier friendly at this worker's volume — see https://developers.cloudflare.com/workers/observability/logs/workers-logs/
[observability]
[observability.logs]
enabled = true
invocation_logs = false   # the fetch() handler also serves the dashboard, so per-invocation logs would capture every HTTP request — keep only our console logs
[observability.traces]
enabled = false
