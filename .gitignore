# Dependencies and build output (root and dashboard/)
node_modules/
dist/

# cf / wrangler local state, generated types, and the DB-IP download cache
.cloudflare/
.wrangler/
.cache/

# Deployment profiles hold your account, zone, and addresses; only the example is shared.
# To share a team profile in an internal copy, add e.g. !profiles/company.json.
profiles/*.json
!profiles/example.json

# Secrets and leftovers from 1.x (.env.legacy is created when .env is converted)
.env
.env.*
.dev.vars
wrangler.toml

# Editor and OS files
.vscode/
.claude/
.DS_Store
