{
  "name": "dmarc-dashboard-kit",
  "version": "2.1.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cf dev",
    "deploy": "bash deploy.sh",
    "migrate:local": "cf d1 migrations apply 00000000-0000-4000-8000-000000000000 --local --persist-to .wrangler/state",
    "update:all": "pnpm update -r",
    "prepare": "git config core.hooksPath .githooks",
    "scan:secrets": "betterleaks git --redact --no-banner ."
  },
  "dependencies": {
    "fast-xml-parser": "^5.11.2",
    "mmdb-lib": "^3.0.3",
    "postal-mime": "^4.1.4",
    "unzipit": "^2.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261027.1",
    "@types/node": "^25.9.9",
    "cf": "1.0.0-beta.23",
    "typescript": "^6.0.3",
    "wrangler": "^4.153.0"
  },
  "packageManager": "pnpm@12.16.0"
}
